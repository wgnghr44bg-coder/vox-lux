{"Z": [[0.3, 3.537, "It's 7:15 in the morning. You walk into the kitchen.", "keuken", "N"], [3.987, 8.536, "And above your dad's head, there's a glowing number. Sixty-four thousand dollars.", "keuken", "N"], [8.886, 10.788, "Morning, buddy. Why are you staring at me?", "keuken", "DAD"], [11.138, 13.552, "Then your mom walks in. Ninety-one thousand.", "keuken", "N"], [13.902, 15.479, "What? What's so funny?", "keuken", "DAD"], [15.829, 19.45, "Your little sister has one too. Two hundred sixty dollars. A year.", "keuken", "N"], [19.8, 21.418, "Stop looking at my money!", "keuken", "SIS"], [21.768, 24.408, "So, what if you could see how much everyone earns?", "keuken", "N"], [25.208, 30.269, "Rules. The number shows what someone makes in one year. It works on everyone. Except you.", "keuken", "N"], [30.719, 34.186, "Then the doorbell rings. It's the mailman. Fifty-two thousand.", "keuken", "N"], [34.636, 39.146, "He hands your dad an envelope. Your dad opens it. And his number starts to change.", "keuken", "N"], [39.496, 40.995, "Wait. What is this?", "keuken", "DAD"], [41.345, 44.171, "Seventy thousand. Seventy-five. Eighty thousand.", "keuken", "N"], [44.521, 45.953, "You got the promotion?", "keuken", "MOM"], [46.303, 51.408, "Your mom hugs him. Your sister starts dancing. And you look at your dad's number one more time.", "keuken", "N"], [51.858, 56.256, "Because next to it, a tiny second number just appeared. And it's counting down.", "keuken", "N"]], "WO": [[0, "It's", 0.3, 0.52], [0, "7.15", 0.52, 1.16], [0, "in", 1.16, 1.46], [0, "the", 1.46, 1.54], [0, "morning.", 1.54, 2.06], [0, "You", 2.46, 2.54], [0, "walk", 2.54, 2.78], [0, "into", 2.78, 2.94], [0, "the", 2.94, 3.06], [0, "kitchen.", 3.06, 3.52], [1, "And", 3.99, 4.11], [1, "above", 4.11, 4.33], [1, "your", 4.33, 4.49], [1, "dad's", 4.49, 4.87], [1, "head,", 4.87, 5.29], [1, "there's", 5.29, 5.57], [1, "a", 5.57, 5.65], [1, "glowing", 5.65, 5.99], [1, "number,", 5.99, 6.67], [1, "$64,000.", 6.67, 8.51], [