# Copy to .env (setup.ps1 does this) and fill in. .env is never committed (see .gitignore).
# xAI text-to-speech, voice "atlas" (paid per use, about 1 cent per Short): https://console.x.ai -> API Keys
XAI_API_KEY=
# Optional: ElevenLabs speech-to-text for exact word times (paid; without it the pauses in the take are used)
ELEVENLABS_API_KEY=
# Optional: 1 = render with the graphics card instead of SwiftShader (faster; picture may differ slightly)
# WHATIF_GPU=1
